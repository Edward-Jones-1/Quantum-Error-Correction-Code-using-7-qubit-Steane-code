### Simulation ###

simulator = AerSimulator(method = "stabilizer")
compiled_circuit = transpile(qc, simulator)
job = simulator.run(compiled_circuit, shots=1000, memory = True)
result = job.result()
mem = result.get_memory()
counts = result.get_counts(qc)

for bitstring, count in counts.items():
    parts = bitstring.split()
    if len(parts) == 14: # 12 single-bit cregisters + 2 6 bit cregisters.
        syn_check_str = parts[0]
        error_str = parts[1]
        syn_post_bits_str = "".join(parts[2:8]) # syn_post bits
        syn_pre_bits_str = "".join(parts[8:14]) # syn_pre bits
        print(f"syn_pre: {syn_pre_bits_str} | syn_post: {syn_post_bits_str} | error: {error_str} | syn_check: {syn_check_str} (Count: {count})")

