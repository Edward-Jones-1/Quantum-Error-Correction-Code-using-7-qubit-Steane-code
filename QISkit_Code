qc.cx(stab_pre[5], q[4])
qc.cx(stab_pre[5], q[5])
qc.cx(stab_pre[5], q[6])
qc.h(stab_pre[5])

for i in range(6):
    qc.measure(stab_pre[i], syn_pre_bits[i][0])
    qc.reset(stab_pre[i]) #Good practice to reuse qubits but does not benefit the circuit in this case

### apply error ###
def apply_random_error(qc, q):
    """Applies a random single-qubit error (I, X, Y, or Z) to one random qubit."""
    error_gates = ['i', 'x', 'y', 'z']
    random_gate = np.random.choice(error_gates)
    random_qubit = np.random.randint(0, 7)

    if random_gate == 'y':
        qc.y(q[random_qubit])

    if random_gate == 'z':
        qc.z(q[random_qubit])

    elif random_gate == 'x':
       qc.x(q[random_qubit])
    #Identity has no effect
apply_random_error(qc, q)

