import numpy as np
from qiskit import QuantumCircuit, QuantumRegister, ClassicalRegister, transpile
from qiskit_aer import AerSimulator


q = QuantumRegister(7, 'q') #Initialise 7 physical qubits.
stab_pre = QuantumRegister(6, 'stab_pre')  # The 6 qubits forming the stabilizer generators.
stab_post = QuantumRegister(6, 'stab_post')
syn_pre_bits = [ClassicalRegister(1, f'pre_{i}') for i in range(6)] # Classical bits to store syndrome
syn_post_bits = [ClassicalRegister(1, f'post_{i}') for i in range(6)] # Classical bits to store syndrome
e_ancilla = QuantumRegister(6, 'e_ancilla') # Ancilla qubits for determining error.
error = ClassicalRegister(6, 'error')
stab_check = QuantumRegister(6, 'stab_check') # Confirmation measurements.
syn_check = ClassicalRegister(6, 'syn_check')

qc = QuantumCircuit(q, stab_pre, stab_post, e_ancilla, *syn_pre_bits, *syn_post_bits, error, stab_check, syn_check)




### initialise data qubit ###
qc.h(q[0])


### Arbtitrary information qubit encoded into 7 physical qubits - 1 logical qubit ###
qc.cx(q[0], q[5])
qc.cx(q[0], q[6])
qc.h(q[2])
qc.cx(q[2], q[0])
qc.cx(q[2], q[4])
qc.cx(q[2], q[6])
qc.h(q[1])
qc.cx(q[1], q[2])
qc.cx(q[1], q[5])
qc.h(q[3])
qc.cx(q[3], q[4])
qc.cx(q[3], q[5])
qc.cx(q[3], q[6])

qc.barrier(q)


