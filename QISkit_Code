qc.barrier(q)

### Effective XOR onto error ancilla ###

for i in range(6):
    with qc.if_test((syn_pre_bits[i], 1)):
        qc.x(e_ancilla[i])
    with qc.if_test((syn_post_bits[i], 1)):
        qc.x(e_ancilla[i])

qc.measure(e_ancilla, error)
qc.barrier(q)

### Apply gates (as corrections) based on syndrome ###

trivial = '000000'
value = int(trivial, 2)
with qc.if_test((error, value)):
  pass

X = np.arange(1, 8)
Z = np.arange(1, 8)

### Apply X corrections ###
for i in range(7):
    with qc.if_test((error, int(X[i]))):
        qc.x(q[i])

### Apply Z corrections ###
for i in range(7):
    syndrome_z = Z[i] * 8
    with qc.if_test((error, int(syndrome_z))):
        qc.z(q[i])

### Apply Y corrections ###
for i in range(7):
    syndrome_y = 9 * (i + 1)
    with qc.if_test((error, int(syndrome_y))):
        qc.y(q[i])

